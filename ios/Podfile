require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '10.0'

target 'PxViewR' do
  config = use_native_modules!

  use_react_native!(:path => config["reactNativePath"])

  target 'PxViewRTests' do
    inherit! :complete
    # Pods for testing
  end

  # Enables Flipper.
  #
  # Note that if you have use_frameworks! enabled, Flipper will not work and
  # you should disable these next few lines.
  # Legacy Flipper-Glog (0.3.6) still tries to compile armv7 on modern
  # Xcode. Disable this optional debugger only in GitHub Actions; local
  # developer builds retain precisely the existing Flipper configuration.
  use_flipper!({ 'Flipper' => '0.87.0' }) unless ENV['CI'] == 'true'
  post_install do |installer|
    flipper_post_install(installer) unless ENV['CI'] == 'true'

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
       config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '9.0'
      end
     end
  end
end

target 'PxViewR-tvOS' do
  # Pods for RnDiffApp-tvOS
  target 'PxViewR-tvOSTests' do
    inherit! :search_paths
    # Pods for testing
  end
end
